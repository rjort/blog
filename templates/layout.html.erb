<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-black overflow-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title ? "#{@page_title} - Rjort" : "Rjort" %></title>
  <link rel="icon" href="<%= @asset_prefix %>/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= @asset_prefix %>/assets/tailwind.css">
</head>
<body class="bg-black text-gray-300 font-mono h-screen flex flex-col p-4 antialiased selection:bg-gray-300 selection:text-black overflow-hidden" data-page-type="<%= @page_type %>" data-root-path="<%= @root_path %>">

  <!-- Header retro -->
  <header class="flex justify-between items-center mb-4 border border-gray-500 p-2 bg-gray-900 shrink-0">
    <div class="font-bold">
      <% if @header_left %>
        <%= @header_left %>
      <% else %>
        <a href="<%= @root_path %>" class="hover:bg-gray-300 hover:text-black px-1">[Rjort]</a>
      <% end %>
    </div>
    <div class="font-bold">
      <%= @header_right %>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-grow flex flex-col overflow-hidden min-h-0">
    <%= yield %>
  </main>

  <!-- Footer retro -->
  <footer class="mt-4 border border-gray-500 p-2 bg-gray-900 text-center font-bold text-gray-400 text-xs sm:text-sm shrink-0">
    © 2026 Rjort. Todos os direitos reservados.
  </footer>

  <script src="<%= @asset_prefix %>/assets/terminal_nav.js"></script>
</body>
</html>
