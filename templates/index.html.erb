<div class="flex-1 flex flex-col min-h-0">
  <div class="mb-4">
    <div class="inline-block bg-gray-300 text-black px-2 py-0.5 font-bold mb-2">
      Logs:
    </div>
  </div>

  <div class="flex-1 overflow-y-auto pr-2 space-y-6">
    <% @posts_by_year.each do |year, posts| %>
      <section class="space-y-2">
        <h2 class="text-gray-400 font-bold border-b border-gray-700 pb-1 mb-2">
          <%= year %>:
        </h2>

        <ul class="space-y-1">
          <% posts.each do |post| %>
            <li>
              <a href="<%= @post_prefix %>/posts/<%= post.slug %>"
                 class="nav-item flex items-baseline space-x-2 p-1 hover:bg-gray-300 hover:text-black transition-colors group">
                <span class="text-xs text-gray-500 group-hover:text-black shrink-0 font-mono">
                  <%= post.formatted_date %>
                </span>
                <span class="truncate font-mono">
                  <%= post.title %>
                </span>
              </a>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
